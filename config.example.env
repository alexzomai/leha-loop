# leha-loop config for one project. Put it in ~/.config/leha-loop/<repo-folder-name>.env
# (only there: it is bash and gets executed, so it is never read from the repository).
# This is bash: arrays go in parentheses. No secrets.

REPO_PATH=/path/to/repo         # this config's repository; another repo with the same folder name is refused (use FB_PROJ there)
BASE=main                       # branch we merge into
PREFIX="myproj-"                # terminal name prefix (hc names are shared across projects)
MAX_REVIEW_ROUNDS=3             # review rounds per branch before the Boss asks the user
MAX_PARALLEL_WORKERS=3          # unfinished registered tasks, through review/merge; scope conflicts also serialize
# FB_TASK_HOME defaults to ~/.local/share/leha-loop/<project> (durable, not the runtime cache)
MERGE_TAB=merge                 # app tab for the merger (in the Boss's space)
DEV_TAB=dev                     # app tab for the dev server
DEV_NAME=myproj-dev             # dev server terminal name
DEV_PORT=3000                   # main dev server port (off limits to workers and reviewers)
DEV_URL=http://localhost:3000   # where the user looks at merged work
DEV_CMD=(npm run dev -- -p 3000) # empty: no dev server
WORKER_PORTS=3100-3199          # each worker gets its own port from this range

# Workers run in the background, so they need a permission mode that does not stop at every prompt.
WORKER_CMD=(claude --model claude-opus-5-5 --effort medium --permission-mode auto)
MERGER_CMD=(claude --model claude-opus-5-5 --effort medium --permission-mode auto)
# Reviewer: a new Codex per review, started by the worker beside itself; review.sh adds -m and --add-dir and accepts the folder trust dialog
REVIEWER_CMD=(codex --no-daemon -s workspace-write -a never)
REVIEWER_MODEL=latest-sol       # newest gpt-<version>-sol from Codex's model cache, or an exact model id
# behind a proxy: REVIEWER_CMD=(env HTTPS_PROXY=http://127.0.0.1:1081 HTTP_PROXY=http://127.0.0.1:1081 NO_PROXY=localhost,127.0.0.1 codex ...)
MERGER_RESET=/clear             # fresh merger context before each merge (empty: keep it)

COPY=(node_modules .env.local)  # what to copy from the main checkout into a worktree (gitignored files)
WT_SETUP=""                     # command to run in a new worktree, e.g. installing skills (log: ~/.cache/leha-loop/<project>/setup-<branch>.log)

# Project rules for all agents go in ~/.config/leha-loop/<project>.notes.md
